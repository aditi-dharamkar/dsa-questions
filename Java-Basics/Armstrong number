class Solution {
    static boolean armstrongNumber(int n) {
        // code here
        int original=n;
        int num=0;
        int count=0;
        int temp=n;
       while(n!=0){
         count++;
         n=n/10;
       }
       temp=original;
       while(temp!=0){
           int digit=temp%10;
           num+=(int)Math.pow(digit,count);
           temp=temp/10;
       }
       if(num==original){
           return true;
       }
       return false;
    }
}
