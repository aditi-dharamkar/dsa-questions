class Solution {
    public void moveZeroes(int[] nums) {
        int n=nums.length-1;
        for(int i=0;i<n;i++){
            for(int j=0;j<n-i;j++){
                if(nums[j]==0){
                    int temp=nums[j];
                    nums[j]=nums[j+1];
                    nums[j+1]=temp;
                }
            }
        }
    }
}
