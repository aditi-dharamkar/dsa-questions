class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int greatest=arr[0];
        int secondLargest=-1;
        for(int i=0;i<arr.length;i++){
            if(arr[i]>greatest){
                greatest=arr[i];
            }
        }
        for(int i=0;i<arr.length;i++){
            if(arr[i]<greatest && arr[i]>secondLargest){
                secondLargest=arr[i];
            }
        }
        return secondLargest;
    
       
    }
}
