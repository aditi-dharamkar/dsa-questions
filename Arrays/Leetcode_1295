class Solution {
    public int findNumbers(int[] nums) {
        int count=0;
        int reNum=0;
        for(int i=0;i<nums.length;i++){
            int n=nums[i];
            int digitCount=0;
            while(n>0){
                n/=10;
                digitCount+=1;
            }
            if(digitCount%2==0){
                count++;
                reNum=count;
            }
             if(nums.length==1&&digitCount%2==0){
                reNum=1;
            }
        }
        return reNum;   
    }
}
